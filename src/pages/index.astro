---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CloudSection from '../components/CloudSection.astro';
import ContactForm from '../components/ContactForm.astro';
import { experience } from '../data/experience';
import { skills, certifications } from '../data/skills';
import { withBase } from '../lib/url';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const other = projects.filter((p) => !p.data.featured);
---
<Base>
  <Hero />

  <section id="work" class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Selected work</p>
        <h2>Things I've built</h2>
        <p class="lead">Each case study covers the problem, the architecture, and the trade-offs I made along the way.</p>
      </div>
      <div class="grid two">
        {featured.map((p) => <ProjectCard project={p} />)}
      </div>
      {other.length > 0 && (
        <div class="other">
          <h3>More projects</h3>
          <ul>
            {other.map((p) => (
              <li><a href={withBase(`work/${p.id}/`)}>{p.data.title}</a> <span>{p.data.summary}</span></li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <CloudSection projects={projects} />

  {experience.length > 0 && (
    <section id="experience" class="section">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Experience</p>
          <h2>Where I've worked</h2>
        </div>
        <ol class="timeline">
          {experience.map((r) => (
            <li>
              <p class="when">{r.start} to {r.end}</p>
              <h3>{r.title} · {r.company}</h3>
              <ul>{r.points.map((pt) => <li>{pt}</li>)}</ul>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <section id="skills" class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Skills</p>
        <h2>What I work with</h2>
      </div>
      <div class="grid three">
        {skills.map((g) => (
          <div class="card">
            <h3>{g.group}</h3>
            <ul class="chips">{g.items.map((i) => <li class="chip">{i}</li>)}</ul>
          </div>
        ))}
      </div>
      {certifications.length > 0 && (
        <div class="other">
          <h3>Certifications</h3>
          <ul>
            {certifications.map((c) => (
              <li>{c.url ? <a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a> : c.name} <span>{c.issuer}, {c.year}</span></li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <ContactForm />
</Base>

<style>
  .other { margin-top: 2.5rem; }
  .other ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .other li a { font-weight: 600; }
  .other li span { color: var(--muted); }
  .other li span::before { content: ' · '; }
  .timeline { list-style: none; padding: 0; margin: 0; border-left: 2px solid var(--border); }
  .timeline > li { position: relative; padding: 0 0 2rem 1.5rem; }
  .timeline > li::before { content: ''; position: absolute; left: -7px; top: 0.45rem; width: 12px; height: 12px; border-radius: 50%; background: var(--accent); }
  .when { font-family: var(--mono); font-size: 0.8rem; color: var(--muted); margin: 0 0 0.25rem; }
  .timeline ul { color: var(--muted); padding-left: 1.1rem; margin: 0; }
</style>
