---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import photo from '../assets/myface.png';
import { site } from '../data/site';
import { withBase } from '../lib/url';
---
<div class="hero-bg">
  <section class="hero container">
    <div class="text">
      <p class="eyebrow">{site.role}</p>
      <h1>Hi, I'm <span class="grad">{site.name.split(' ')[0]}</span>.</h1>
      <p class="location"><Icon name="map-pin" /> {site.location}</p>
      <p class="tagline">{site.tagline}</p>
      <ul class="highlights">
        {site.highlights.map((h) => <li>{h}</li>)}
      </ul>
      <ul class="actions">
        <li><a class="btn primary" href={withBase('/#work')}>See my work <Icon name="arrow-right" /></a></li>
        {site.cv && <li><a class="btn" href={withBase(site.cv)} download><Icon name="download" /> CV</a></li>}
        <li><a class="btn" href={site.links.github} target="_blank" rel="noopener noreferrer"><Icon name="github" /> GitHub</a></li>
        <li><a class="btn" href={site.links.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="linkedin" /> LinkedIn</a></li>
      </ul>
    </div>
    <div class="photo-wrap">
      <Image src={photo} alt={`Photo of ${site.name}`} width={360} height={360} class="photo" loading="eager" />
    </div>
  </section>
</div>

<style>
  .hero-bg {
    background:
      radial-gradient(60rem 30rem at 85% -10%, var(--glow-1), transparent 60%),
      radial-gradient(50rem 28rem at -10% 110%, var(--glow-2), transparent 60%),
      linear-gradient(180deg, var(--hero-top), var(--bg));
  }
  .hero { display: grid; grid-template-columns: 1fr auto; gap: 3rem; align-items: center; padding: 5rem 0 4.5rem; }
  .grad {
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .location { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--muted); font-weight: 550; margin-bottom: 1rem; }
  .location :global(svg) { width: 1.1em; height: 1.1em; color: var(--accent-2); }
  .tagline { font-size: clamp(1.15rem, 2.2vw, 1.35rem); color: var(--muted); max-width: 38rem; }
  .highlights { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 0 0 2rem; font-size: 0.85rem; font-weight: 550; }
  .highlights li { padding: 0.3rem 0.75rem; border-radius: 999px; background: var(--accent-soft); color: var(--accent); }
  .highlights li:nth-child(2) { background: var(--accent-2-soft); color: var(--accent-2); }
  .photo-wrap {
    padding: 5px; border-radius: 50%;
    background: conic-gradient(from 200deg, var(--accent), var(--accent-2), var(--azure), var(--aws), var(--accent));
  }
  .photo {
    width: 240px; height: 240px; border-radius: 50%;
    object-fit: cover; object-position: 61% 56%;
    border: 4px solid var(--bg);
  }
  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; gap: 2rem; padding: 3rem 0; }
    .photo-wrap { order: -1; justify-self: start; }
    .photo { width: 140px; height: 140px; }
  }
</style>
